<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="LeonScenarioVariantTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#184dc4" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" Color="#08184e" Opacity="1" BlurRadius="6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClaireScenarioVariantTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#9a0035" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" Color="#2c0014" Opacity="1" BlurRadius="6"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>