<UserControl x:Class="biorand.app.Views.Game.GameListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:biorand.app.Views.Game"
             mc:Ignorable="d"
             xmlns:prism="http://prismlibrary.com/">
    <Grid>
        <StackPanel Orientation="Vertical">
            <Image Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImagePath}" d:Source="/Resources/Images/RE2/logo.png" />
            <Border Margin="2,-25,0,0" Height="20">
                <TextBlock FontSize="8" Text="{Binding DisplayName}" d:Text="Resident Evil 2" VerticalAlignment="Bottom" />
            </Border>
        </StackPanel>
        <StackPanel Background="Black" Opacity="0.4" Cursor="Hand" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=negate}" d:Visibility="Collapsed" />
    </Grid>
</UserControl>
