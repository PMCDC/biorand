<UserControl x:Class="biorand.app.Views.Player.PlayerConfiguration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:biorand.app.Views.Player"
             xmlns:common="clr-namespace:biorand.app.Views.Common"
             xmlns:toggleButtons="clr-namespace:biorand.app.Controls.ToggleButtons"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <common:BioConfigurationGroup GroupTitle="Change Playable Character" IsGroupTogglelable="True" IsGroupEnabled="{Binding IsEnabled}">
        <common:BioConfigurationGroup.GroupContent>
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="40" Source="{Binding MainPlayer0Information.FacePngPath}" d:Source="/Resources/Images/RE2/Players/Leon.png" ></Image>
                <Image Grid.Column="1" Margin="10,0,10,0" Width="20" Source="{StaticResource RightArrowIcon}" ToolTipService.InitialShowDelay="0">
                    <Image.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MainPlayer0Information.DisplayName}" Foreground="{StaticResource BiorandImportantTextColor}" />
                            <TextBlock Text=" becomes..." />
                        </StackPanel>
                    </Image.ToolTip>
                </Image>
                <ComboBox Grid.Column="2" Margin="0,0,10,0" Width="50" Visibility="{Binding IsSwapCharacterEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=negate}" BorderBrush="Transparent" ItemsSource="{Binding Player0Informations}" SelectedItem="{Binding SelectedPlayer0Information}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <local:PlayerListItem />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" Margin="0,0,10,0" Width="50" Visibility="{Binding IsSwapCharacterEnabled, Converter={StaticResource BoolToVisibilityConverter}}"  BorderBrush="Transparent" ItemsSource="{Binding Player1Informations}" SelectedItem="{Binding SelectedPlayer1Information}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <local:PlayerListItem />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Grid.Column="3" Visibility="{Binding IsSecondPlayerAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Margin="8,0,10,0" Style="{StaticResource SwapToggleButton}" IsChecked="{Binding IsSwapCharacterEnabled}" ToolTipService.InitialShowDelay="0">
                        <ToggleButton.ToolTip>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Swap Characters:" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Allow male characters to play " />
                                    <TextBlock Text="{Binding MainPlayer1Information.DisplayName}" Foreground="{StaticResource BiorandImportantTextColor}" />
                                    <TextBlock Text="'s scenario, and female characters to play " />
                                    <TextBlock Text="{Binding MainPlayer0Information.DisplayName}" Foreground="{StaticResource BiorandImportantTextColor}" />
                                    <TextBlock Text="'s scenario." />
                                </StackPanel>
                            </StackPanel>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                    <ComboBox Grid.Column="1" Margin="10,0,0,0" Width="50" Visibility="{Binding IsSwapCharacterEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=negate}" BorderBrush="Transparent" ItemsSource="{Binding Player1Informations}" SelectedItem="{Binding SelectedPlayer1Information}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <local:PlayerListItem />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="1" Margin="10,0,0,0" Width="50" Visibility="{Binding IsSwapCharacterEnabled, Converter={StaticResource BoolToVisibilityConverter}}" BorderBrush="Transparent" ItemsSource="{Binding Player0Informations}" SelectedItem="{Binding SelectedPlayer0Information}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <local:PlayerListItem />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Image Grid.Column="2" Margin="10,0,10,0" Width="20" Source="{StaticResource LeftArrowIcon}">
                        <Image.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MainPlayer1Information.DisplayName}" Foreground="{StaticResource BiorandImportantTextColor}" />
                                <TextBlock Text=" becomes..." />
                            </StackPanel>
                        </Image.ToolTip>
                    </Image>
                    <Image Grid.Column="3" Width="40" Source="{Binding MainPlayer1Information.FacePngPath}" d:Source="/Resources/Images/RE2/Players/Claire.png" />
                </Grid>
            </Grid>
        </common:BioConfigurationGroup.GroupContent>
    </common:BioConfigurationGroup>
</UserControl>
