<prism:PrismApplication x:Class="biorand.app.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:biorand.app"
             xmlns:prism="http://prismlibrary.com/">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--Styles-->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/TextBlocks.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ComboBoxes.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Icons.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ToggleButtons.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ToolTips.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ScrollBars.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ListBoxes.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ListViews.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Images.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Borders.xaml"/>
                <ResourceDictionary Source="Resources/Styles/TextBoxes.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Storyboards.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Sliders.xaml"/>

                <!--Converters-->
                <ResourceDictionary Source="Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
