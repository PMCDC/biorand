<UserControl x:Class="biorand.desktop.Views.Common.BioConfigurationGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:biorand.desktop.Views.Common"
             xmlns:toggleButtons="clr-namespace:biorand.desktop.Controls.ToggleButtons"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BiorandGroupHeaderBackgroundColor}" CornerRadius="8" HorizontalAlignment="Left" Width="200" Margin="5,0,0,-10" Panel.ZIndex="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <toggleButtons:CustomToggleButton 
                    Visibility="{Binding IsGroupTogglelable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" 
                    ToggleText="{Binding GroupTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    IsChecked="{Binding IsGroupEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock 
                    Visibility="{Binding IsGroupTogglelable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=negate}" 
                    Text="{Binding GroupTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    FontSize="14" 
                    Margin="0,0,0,4"
                    Typography.Capitals="AllSmallCaps"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource BiorandGroupBackgroundColor}" CornerRadius="8">
            <ContentPresenter 
                Margin="10,15,10,10" 
                Content="{Binding GroupContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>
        <Border Grid.Row="1" 
                d:Visibility="Hidden" 
                Visibility="{Binding IsGroupEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=negate}" 
                Background="{StaticResource BiorandGroupBackgroundColor}" 
                Opacity="0.5" 
                CornerRadius="8"/>
    </Grid>
</UserControl>
